# ==========================================
# DISCORD BOT CREDENTIALS (WAJIB)
# ==========================================
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Opsional: Isi dengan Server ID (Guild ID) untuk sinkronisasi instan Slash Commands
DISCORD_GUILD_ID=1560193635675279402

# ==========================================
# SPOTIFY CREDENTIALS (OPSIONAL)
# ==========================================
# Jika dikosongkan, bot menggunakan fallback public scraper.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ==========================================
# PLAYER & BOT CONFIGURATION
# ==========================================
DEFAULT_VOLUME=80
LEAVE_ON_EMPTY_COOLDOWN=180000
YOUTUBE_COOKIE=

# ==========================================
# ENVIRONMENT & METADATA
# ==========================================
BOT_NAME=Columba
NODE_ENV=development
PORT=8080
